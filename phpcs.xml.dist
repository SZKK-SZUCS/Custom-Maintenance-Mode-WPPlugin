<?xml version="1.0"?>
<ruleset name="custom-maintenance-mode">
    <description>WordPress Coding Standards a custom-maintenance-mode pluginhoz</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/plugin-update-checker/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress"/>
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>/custom-maintenance-mode\.php$/</exclude-pattern>
    </rule>
</ruleset>
